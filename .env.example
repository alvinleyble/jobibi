# Jobibi environment template. Copy to .env and fill in.
# No code exists yet — these are the variables the architecture calls for.
#
# THE RULE: anything in this file ships inside the extension bundle and is
# readable by anyone who installs it. Secrets never go here.

# ---------------------------------------------------------------------------
# Extension (public — bundled into the built extension)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
WXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Public by design; RLS is what protects data,
# not the secrecy of this key.
WXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# Edge Function secrets — NOT set here
# ---------------------------------------------------------------------------
# These are set server-side and must never appear in this file or in any
# extension bundle:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# The extension never calls the model directly. Every AI call goes through an
# Edge Function so the key stays server-side and every request is authenticated
# and rate-limitable per user (see docs/ARCHITECTURE.md).
#
# SUPABASE_SERVICE_ROLE_KEY is injected into Edge Functions automatically by
# Supabase. Never add it here.
